[user]
    email = milkias.yeheyis@yahoo.com
	name = Milkias Yeheyis
	signingkey = /home/mike/.ssh/id_ed25519.pub

[core]
    editor = nvim
	preloadIndex = true

[init]
	defaultBranch = main
[color]
	ui = auto

[pull]
	; ff = only
    rebase = true

[rebase]
    autoStash = true
[alias]
	c = commit -m
	ac = commit -am
    staash = stash --all

[url "git@github.com:milkias17/"]
    insteadOf = "mike:"

[url "git@github.com:"]
    insteadOf = "gh:"

[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[log]
	date = format:%Y-%m-%d %I:%M %p
[commit]
	gpgsign = true
