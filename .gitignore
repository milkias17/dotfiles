.config/kitty/sessions
# pi: credentials, session history, and machine-local caches must never be tracked
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/models-store.json
.pi/agent/run-history.jsonl
.pi/agent/state/
.pi/agent/web-search-cache/
.pi/agent/fff/
.pi/agent/npm/
.pi/agent/git/
.pi/agent/missions/
.pi/agent/trust.json
.agents/.skill-lock.json
# ghostty/herdr: backups, logs, sockets, and runtime state must never be tracked
.config/ghostty/*.bak.*
.config/herdr/*.bak.*
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
