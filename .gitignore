.config/kitty/sessions
# pi: credentials, session history, and machine-local caches must never be tracked
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/models-store.json
.pi/agent/run-history.jsonl
.pi/agent/state/
.pi/agent/web-search-cache/
.pi/agent/fff/
.pi/agent/npm/
.pi/agent/git/
.pi/agent/missions/
.pi/agent/trust.json
.agents/.skill-lock.json
# ghostty/herdr: backups, logs, sockets, and runtime state must never be tracked
.config/ghostty/*.bak.*
.config/herdr/*.bak.*
.config/herdr/*.log
.config/herdr/*.sock
.config/herdr/session.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock

# pi: managed runtime / machine-local state that must never be tracked
.pi/agent/sandbox.json.*
.pi/agent/sandbox.json2
.pi/agent/install/
.pi/agent/bin/
.pi/agent/mcp-auth.json
.pi/agent/opencode-go-keys.json
.pi/agent/opencode-go-keys.json.*
.pi/tasks/
.pi/workflows/projects/
